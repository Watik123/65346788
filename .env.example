# Шлях до SQLite. Відносний шлях рахується від кореня репозиторію.
# Для PostgreSQL: DATABASE_URL="postgresql://user:pass@localhost:5432/znyzhky"
DATABASE_URL="file:./data/app.db"

# Збір цін: ми чесно представляємось сайтам і даємо спосіб зв'язатися.
# Вкажіть реальну пошту або адресу сайту. Без цього збір працює, але в User-Agent буде підказка.
SCRAPER_CONTACT="your-email@example.com"
